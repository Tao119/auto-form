# ======================================
# リスト収集AI - 環境変数設定
# ======================================
# このファイルを .env にコピーして各値を設定してください
# cp .env.example .env

# --- Google Custom Search API ---
# https://developers.google.com/custom-search/v1/introduction
GOOGLE_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# --- Google Maps Places API ---
# 同じAPIキーで利用可能（Places APIを有効化すること）
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- OpenAI API (フォーム種別判定) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Google Sheets ---
# スプレッドシートIDは自動作成時に自動入力されます（空欄でOK）
# 既存のスプシを使う場合はURLの /d/{ID}/ 部分を入力
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SHEET_NAME=企業リスト

# スプレッドシートを共有するGmailアドレス（自動作成時に自動共有されます）
SHEETS_OWNER_EMAIL=your_email@gmail.com

# --- Google Service Account (Sheets API認証) ---
# サービスアカウントJSONファイルのパス
GOOGLE_SERVICE_ACCOUNT_PATH=./config/service-account.json

# --- 実行設定 ---
# 1バッチあたりの処理件数（レート制限対策）
BATCH_SIZE=5
# リクエスト間隔 (ミリ秒)
REQUEST_DELAY_MS=2000
# HTTPタイムアウト (ミリ秒)
HTTP_TIMEOUT_MS=10000
# リトライ回数
MAX_RETRIES=3

# --- ログ設定 ---
LOG_LEVEL=info
LOG_FILE=./logs/collector.log
