        "jsCode": "\nconst items = $input.all();\nconst companies = items.map(i => ({\n  name: i.json[\"会社名\"] || \"\",\n  hpUrl: i.json[\"HP URL\"] || \"\",\n  formUrl: i.json[\"フォームURL\"] || \"\",\n  phone: i.json[\"電話番号\"] || \"\",\n  email: i.json[\"メールアドレス\"] || \"\",\n  industry: i.json[\"業種\"] || \"\",\n  area: i.json[\"エリア\"] || \"\",\n  formType: i.json[\"フォーム種別\"] || \"\",\n  status: i.json[\"ステータス\"] || \"未送信\",\n  projectId: i.json[\"プロジェクトID\"] || \"\",\n  runId: i.json[\"実行ID\"] || \"\",\n  collectedAt: i.json[\"収集日時\"] || \"\"\n}));\nconst runId = items[0]?.json[\"実行ID\"] || \"\";\nreturn [{ json: { status: \"success\", companies, runId } }];\n"
      },
