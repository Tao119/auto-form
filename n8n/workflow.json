      "name": "URL収集",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// 全企業URLを1つのリストに集約してscrape APIに渡す\nconst items = $input.all();\nconst urlItems = items.map(({ json: c }) => ({\n  url: c.companyUrl || '',\n  baseUrl: c.companyUrl || '',\n})).filter(x => x.url);\n\nconst requestBody = JSON.stringify({\n  items: urlItems,\n  timeoutMs: 8000,\n  concurrency: 5,\n  fetchFormPage: true,\n});\n\nreturn [{ json: { urlItems, companies: items.map(i => i.json), requestBody } }];\n"
      }
    },
    {
      "id": "expand-v2",
      "name": "結果展開・整形",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// スクレイプAPI結果を展開\nconst allInput = $input.all();\nif (!allInput.length) return [];\n\nconst item = allInput[0].json;\nconst results = item.results || [];\n\nif (!results.length) return [];\n\n// URL収集ノードから元の企業情報（会社名等）を取得\nlet companies = [];\ntry {\n  companies = $('URL収集').item.json.companies || [];\n} catch(e) {}\n\n// URLをキーにして会社名を引く\nconst companyMap = {};\nfor (const c of companies) {\n  if (c.companyUrl) companyMap[c.companyUrl] = c;\n}\n\nreturn results\n  .filter(r => r.url || r.baseUrl)\n  .map(r => {\n    const origUrl = r.url || r.baseUrl || '';\n    const orig = companyMap[origUrl] || {};\n    return { json: {\n      companyUrl: origUrl,\n      companyName: orig.companyName || r.companyName || '',\n      keyword: orig.keyword || '',\n      formUrl: r.formUrl || null,\n      email: r.email || null,\n      phone: r.phone || null,\n      address: r.address || null,\n      hasContactLink: r.hasContactLink || false,\n      contactLinks: r.contactLinks || [],\n      formPageTitle: r.formPageTitle || '',\n      formTypeHint: r.formTypeHint || 'unknown',\n      error: r.error || null,\n    } };\n  });"
      }
    },
