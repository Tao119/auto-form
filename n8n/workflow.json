    {
      "id": "form-url-dup-check",
      "name": "フォームURL重複チェック",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        240
      ],
      "parameters": {
        "jsCode": "// フォームURLの重複チェック\n// L-05で取得した既存フォームURLと照合する\n\nconst item = $input.item.json;\n\nfunction normalizeFormUrl(url) {\n  if (!url) return '';\n  try {\n    const u = new URL(url);\n    return (u.hostname + u.pathname).toLowerCase().replace(/^\\/|\\/$|www\\./g, '').replace(/\\/{2,}/g, '/');\n  } catch {\n    return url.toLowerCase().trim();\n  }\n}\n\nconst currentFormUrl = normalizeFormUrl(item.formUrl || '');\n\n// L-05重複判定が持っている既存フォームURLリストを参照\nconst existingFormUrls = new Set(\n  ($('L-05: 重複判定').item.json.existingFormUrlsArray || [])\n);\n\nconst isFormDuplicate = currentFormUrl ? existingFormUrls.has(currentFormUrl) : false;\n\nif (isFormDuplicate) {\n  // フォームURL重複 → このアイテムはスキップ（空配列を返すと以降に渡らない）\n  return [];\n}\n\nreturn [{ json: item }];\n"
      }
    }
  ],
