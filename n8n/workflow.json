          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4o-mini"
        },
        "messages": {
          "values": [
            {
              "content": "あなたはWebフォームの種別を判定する専門家です。\nフォームページの情報から「問い合わせフォーム」か「予約フォーム」かを判定してください。\n\n問い合わせフォーム（inquiry）: 質問・相談・見積もり依頼を受け付けるフォーム\n予約フォーム（booking）: 来店・施術の日時予約フォーム（カレンダー選択を含む）\n不明（unknown）: 判定できない\n\n必ずJSONで回答してください: {\"type\":\"inquiry\"|\"booking\"|\"unknown\",\"reason\":\"理由\"}"
            },
            {
              "role": "user",
              "content": "=フォームURL: {{ $json.formUrl }}\nページタイトル: {{ $json.formPageTitle || '' }}\nリンクテキスト: {{ $json.contactLinks?.[0]?.text || '' }}\nページテキスト（抜粋）:\n{{ ($json.formPageHtml || '').slice(0, 1000) }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "id": "gpt-classify-form",
      "name": "L-04: GPTフォーム種別判定",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        2400,
        180
      ],
      "credentials": {
        "openAiApi": {
          "id": "0fzj9kggITsfAgbc",
          "name": "OpenAI account"
        }
