    {
      "parameters": {
        "jsCode": "// L-05: 重複チェック（HP URL + フォームURL）\nconst existingData = $('L-05: 既存データ取得（重複チェック用）').all();\nconst currentCompany = $input.item.json;\n\nfunction normalizeUrl(url) {\n  if (!url) return '';\n  try {\n    return new URL(url).hostname.toLowerCase().replace(/^www\\./, '');\n  } catch {\n    return url.toLowerCase().trim();\n  }\n}\n\nfunction normalizeFormUrl(url) {\n  if (!url) return '';\n  try {\n    const u = new URL(url);\n    // ホスト名 + パスで判定（クエリ・フラグメント除外）\n    return (u.hostname + u.pathname).toLowerCase().replace(/^\\/|\\/$|www\\./g, '').replace(/\\/{2,}/g, '/');\n  } catch {\n    return url.toLowerCase().trim();\n  }\n}\n\n// 既存 HP URL Set\nconst existingHpUrls = new Set(\n  existingData.map(r => normalizeUrl(r.json['HP URL'] || r.json['B'] || '')).filter(Boolean)\n);\n\n// 既存 フォームURL Set\nconst existingFormUrls = new Set(\n  existingData.map(r => normalizeFormUrl(r.json['フォームURL'] || r.json['C'] || '')).filter(Boolean)\n);\n\nconst currentHp   = normalizeUrl(currentCompany.companyUrl || '');\nconst isDuplicate = existingHpUrls.has(currentHp);\n\nreturn [{\n  json: {\n    ...currentCompany,\n    isDuplicate,\n    normalizedHpUrl: currentHp,\n    existingFormUrlsArray: [...existingFormUrls]  // 後段のフォームURL重複チェックで使う\n  }\n}];\n"
      },
      "id": "duplicate-check",
      "name": "L-05: 重複判定",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    },
