    {
      "parameters": {
        "jsCode": "// フォームページHTMLを整形してタイトルを抽出\nconst html = $input.item.json.data || '';\nconst prevData = $input.item.json;\n\nconst titleMatch = html.match ? html.match(/<title[^>]*>([^<]*)<\\/title>/i) : null;\nconst title = titleMatch ? titleMatch[1].trim() : '';\n\n// テキスト抽出（script/style除去）\nconst cleanText = typeof html === 'string'\n  ? html\n      .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n      .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/\\s+/g, ' ')\n      .trim()\n      .slice(0, 2000)\n  : '';\n\n// フォーム要素が存在するか確認\nconst hasFormElements = /<form|<input|<textarea/i.test(html);\n\nreturn [{\n  json: {\n    ...prevData,\n    formPageHtml: cleanText,\n    formPageTitle: title,\n    hasFormElements\n  }\n}];"
      },
      "id": "parse-form-page",
      "name": "フォームページHTML解析",
      "type": "n8n-nodes-base.code",
