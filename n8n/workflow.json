    {
      "parameters": {
        "jsCode": "// CSEレスポンスを企業データに整形（ホストレベルdedup込み）\nconst p = $('L-01: 検索パラメータ設定').item.json;\nconst items = $input.all();\n\nconst SKIP_DOMAINS = [\n  // ポータル・グルメ・地図\n  'jalan.net','tabelog.com','hotpepper.jp','ekiten.jp','townpage.ntt.co.jp',\n  'navitime.co.jp','navitime.jp','mapion.co.jp','its-mo.com','iphone.jorudan.co.jp',\n  'yelp.com','yelp.co.jp','retty.me','gurunavi.com','gnavi.co.jp','r.gnavi.co.jp',\n  // SNS・プラットフォーム\n  'google.com','facebook.com','instagram.com','twitter.com','x.com',\n  'youtube.com','wikipedia.org','linkedin.com','tiktok.com','pinterest.com',\n  'maps.apple.com','maps.google.com',\n  // EC・求人\n  'recruit.co.jp','indeed.com','wantedly.com','yahoo.co.jp',\n  'rakuten.co.jp','amazon.co.jp',\n  // 美容・予約ポータル\n  'beauty.hotpepper.jp','minimo.io','hairbook.jp','riyou.jp',\n  'bestsalonreport.jp','beauty-park.jp','minimodel.jp','cuts.jp',\n  'hairsalon-map.com','9483.jp','styledesigner.net','kotomise.jp',\n  'repicolle.jp','hair.socie.jp','beautysalon.jp-book.store','beautysalon.potatoo.jp',\n  // 医療・整骨ポータル\n  'epark.jp','homemate-research.com','iryou.teikyouseido.mhlw.go.jp',\n  'jhdac.org','kiyose.or.jp','katusika-e-toko.com','judo-ch.jp',\n  'body-care.expert','karadarefre.jp',\n  // その他ポータル・アグリゲータ\n  'zehitomo.com','baseconnect.in','pathee.com','hair-land.jp',\n  'seahorsejp.com','web-zest.co.jp','people-brand.com',\n  'palanjp.com','beauty.mirai-agent.jp','aderans.co.jp',\n  'kinujo.jp','am-shuuemura.jp','el.e-shops.jp','modshair.co.jp',\n  'salon.tbmg.jp','higasiyamatotida.wixsite.com',\n];\n\nfunction extractHost(url) {\n  const m = url.match(/^https?:\\/\\/([^/?#]+)/);\n  return m ? m[1].replace(/^www\\./, '') : '';\n}\n\n// ホストレベルdedup: 同じドメインは1件のみ（最初に出た結果を採用）\nconst seenHosts = new Set();\n\nreturn items.reduce((acc, { json: item }) => {\n  const link = item.link || '';\n  if (!link) return acc;\n\n  const host = extractHost(link);\n  if (!host) return acc;\n  if (SKIP_DOMAINS.some(d => host === d || host.endsWith('.' + d))) return acc;\n  if (seenHosts.has(host)) return acc;\n  seenHosts.add(host);\n\n  // 会社名: パイプ/ダッシュで区切られた場合は最も意味のある部分を使用\n  let name = item.title || '';\n  const segments = name.split(/[|–—｜]|-(?=[^-])/).map(s => s.trim()).filter(s => s.length > 0);\n  if (segments.length > 1) {\n    const maxLen = Math.max(...segments.map(s => s.length));\n    if (maxLen > 5) {\n      name = segments.reduce((a, b) => a.length >= b.length ? a : b);\n    }\n  }\n\n  acc.push({ json: {\n    companyName: name,\n    companyUrl:  link,\n    phone:       '',\n    address:     '',\n    industry:    p.industry,\n    area:        p.area,\n    spreadsheetId: p.spreadsheetId || '',\n    projectId:   p.projectId || '',\n    runId:       p.runId || '',\n    keyword:     item.keyword || '',\n    skipItem:    false,\n  }});\n  return acc;\n}, []);\n"
      },
      "id": "map-company-data",
      "name": "企業データを整形",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        240
