        "jsCode": "// L-05: 重複判定（ホストレベルdedupは企業データを整形で実施済み）\n// ここでは全件通過（DBレベルでの重複除去はcomplete APIが担当）\nconst items = $input.all();\nreturn items.map(({ json: c }) => ({\n  json: { ...c, isDuplicate: false }\n}));\n"
      },
